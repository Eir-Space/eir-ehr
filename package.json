{
  "name": "@eir-space/eir-ehr",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx apps/server.ts",
    "staging": "tsx apps/staging-server.ts",
    "worker:integrations": "tsx apps/integration-worker.ts",
    "worker:follow-up": "tsx apps/follow-up-worker.ts",
    "worker:deterioration": "tsx apps/deterioration-worker.ts",
    "worker:coordination": "tsx apps/coordination-worker.ts",
    "demo:integrations": "tsx scripts/integration-sandbox.ts",
    "demo:follow-up": "tsx scripts/follow-up-sandbox.ts",
    "db:migrate": "tsx scripts/migrate-postgres.ts",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "backup:postgres": "tsx scripts/postgres-backup.ts",
    "backup:schedule": "tsx scripts/postgres-backup-loop.ts",
    "restore:postgres": "tsx scripts/postgres-restore.ts",
    "terminology:import": "tsx scripts/import-icd.ts",
    "start": "tsx apps/server.ts",
    "dev:local": "EIR_DEMO=1 EIR_CONFIG=eir.local.profile.yaml tsx apps/server.ts",
    "plugins:dump": "tsx scripts/plugins.ts --dump",
    "openehr:up": "docker compose -f docker/compose.openehr.yml up -d",
    "openehr:down": "docker compose -f docker/compose.openehr.yml down",
    "openehr:setup": "tsx scripts/openehr-setup.ts",
    "test:openehr": "EIR_TEST_OPENEHR_URL=http://127.0.0.1:8090/ehrbase tsx --test tests/content-openehr.test.ts",
    "fhir:up": "docker compose -f docker/compose.fhir.yml up -d",
    "fhir:down": "docker compose -f docker/compose.fhir.yml down",
    "test:fhir": "EIR_TEST_FHIR_URL=http://127.0.0.1:8091/fhir tsx --test tests/content-fhir.test.ts",
    "fhir:validate": "tsx scripts/fhir-validate.ts",
    "video:build": "tsx video/build.ts",
    "video:prepare": "tsx video/prepare.ts",
    "video:still": "tsx video/build.ts",
    "projection:run": "tsx scripts/projection.ts run",
    "projection:reconcile": "tsx scripts/projection.ts reconcile",
    "projection:loop": "tsx scripts/projection.ts loop",
    "eval": "tsx scripts/eval.ts",
    "demo:public": "tsx apps/public-server.ts",
    "hosting:prepare": "tsx scripts/prepare-hosting.ts",
    "social:generate": "tsx scripts/generate-social.ts",
    "hosting:deploy": "tsx scripts/deploy-hosting.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test",
    "test:e2e": "tsx --test tests/*.e2e.ts",
    "plugins": "tsx scripts/plugins.ts",
    "backup": "tsx scripts/backup.ts",
    "smoke:model": "tsx scripts/smoke-model.ts",
    "smoke:public": "tsx scripts/smoke-public.ts",
    "video:remix": "tsx video/remix.ts",
    "video:publish": "tsx video/publish.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.4",
    "@js-temporal/polyfill": "^0.5.1",
    "csv-parse": "^7.0.2",
    "fastify": "^5.6.0",
    "lucide": "^0.468.0",
    "openid-client": "^6.8.8",
    "pdf-lib": "1.17.1",
    "personnummer": "3.2.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "jose": "^6.2.12",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0"
  }
}

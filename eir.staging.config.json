{
  "profile": "persistent-synthetic-staging",
  "plugins": [
    {
      "module": "./plugins/storage-postgres.ts",
      "config": {
        "tenant": "eir-synthetic-staging",
        "connectionStringEnv": "EIR_STAGING_DATABASE_URL",
        "localDevelopmentOnly": true
      }
    },
    { "module": "./plugins/country-se.ts" },
    { "module": "./plugins/terminology-icd-se.ts" },
    { "module": "./plugins/workforce.ts" },
    { "module": "./plugins/identity-staff-local.ts", "config": { "localDevelopmentOnly": true } },
    { "module": "./plugins/access-clinic.ts" },
    { "module": "./plugins/access-review.ts" },
    { "module": "./plugins/care-team.ts" },
    { "module": "./plugins/clinical.ts" },
    { "module": "./plugins/medications.ts" },
    { "module": "./plugins/laboratories.ts" },
    { "module": "./plugins/lab-transport-http.ts" },
    { "module": "./plugins/integrations.ts" },
    { "module": "./plugins/follow-up-policy.ts", "config": { "developmentDefaults": true } },
    { "module": "./plugins/notification-http.ts" },
    { "module": "./plugins/follow-up.ts" },
    {
      "module": "./plugins/modules.ts",
      "config": {
        "definitions": [
          {
            "id": "coordination",
            "name": "Eir Samverkan",
            "moduleVersion": "1.0.0",
            "canEnable": true,
            "restriction": "Samverkan i syntetisk utvecklingsmiljö"
          },
          {
            "id": "deterioration",
            "name": "Vitalövervakning",
            "moduleVersion": "1.0.0",
            "canEnable": true,
            "restriction": "Utvecklingsregler, ej kliniskt validerade"
          }
        ]
      }
    },
    { "module": "./plugins/risk-vitals.ts" },
    {
      "module": "./plugins/coordination-directory.ts",
      "config": {
        "units": [
          {
            "unitId": "demo-primary-care",
            "organisationId": "demo-primary",
            "organisationName": "Björkbackens vård",
            "kind": "primary-care"
          },
          {
            "unitId": "demo-hospital",
            "organisationId": "demo-region",
            "organisationName": "Region Lindängen",
            "kind": "hospital"
          },
          {
            "unitId": "demo-municipality",
            "organisationId": "demo-municipality",
            "organisationName": "Sjövik kommun",
            "kind": "municipality"
          }
        ]
      }
    },
    {
      "module": "./plugins/coordination-payment.ts",
      "config": {
        "version": "synthetic-example-v1",
        "dailyRateOre": 500000,
        "developmentOnly": true
      }
    },
    { "module": "./plugins/coordination.ts" },
    { "module": "./plugins/sip-plans.ts" },
    {
      "module": "./plugins/coordination-documents.ts",
      "config": { "maxBytes": 65536, "developmentPdfDownloads": false }
    },
    { "module": "./plugins/coordination-notifications.ts" },
    { "module": "./plugins/deterioration.ts", "config": { "worker": true } },
    { "module": "./plugins/ai-extractive.ts" },
    { "module": "./plugins/ai-review.ts" },
    { "module": "./plugins/fhir-r4.ts" }
  ],
  "chartRenderers": ["timeline", "table"],
  "defaultRenderer": "timeline"
}
